    "googleapis": "^144.0.0",
    "nodemailer": "^6.10.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.15",
    "@types/uuid": "^9.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^0.34.0"
