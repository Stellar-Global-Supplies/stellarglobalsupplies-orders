{
  "name": "stellar-orders-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --loader tsx ./src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "deploy:lambda": "zip -r function.zip dist node_modules && aws lambda update-function-code --function-name stellar-orders --zip-file fileb://function.zip",
    "test": "vitest"
