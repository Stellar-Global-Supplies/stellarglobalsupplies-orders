# ─────────────────────────────────────────────────────────────
# terraform.tfvars  —  COPY this file, rename, fill in values
# NEVER commit the real terraform.tfvars to git
# ─────────────────────────────────────────────────────────────

aws_region  = "ap-south-1"
domain_name = "orders.stellarglobalsupplies.com"
environment = "production"

# Supabase — set via GitHub Secrets in CI; use env vars locally:
#   export TF_VAR_supabase_url="https://xxxx.supabase.co"
#   export TF_VAR_supabase_service_key="eyJ..."
supabase_url         = ""
supabase_service_key = ""

# Gmail API — OAuth2 credentials are stored in AWS SSM Parameter Store
# and injected into Lambda env vars by the CI/CD pipeline.
# See DEPLOY.md "Gmail Setup" section for how to get these.